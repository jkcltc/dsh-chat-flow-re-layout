{
  "name": "dsh-chat-flow-re-layout",
  "description": "Chat flow layout plugin for the DeepSeek Harness web UI: settled tool calls, context injections and finished reasoning pile horizontally as compact chips.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkcltc/dsh-chat-flow-re-layout.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
